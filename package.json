{
  "name": "optidlss5-ui",
  "productName": "OptiDLSS5-UI",
  "version": "1.39.0",
  "description": "Per-game OptiScaler / DLSS Ray Reconstruction install manager",
  "main": "src/main.js",
  "private": true,
  "author": "OptiDLSS5-UI",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish=never",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.optidlss5ui.app",
    "productName": "OptiDLSS5-UI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "README-END-USER.txt",
        "to": "README.txt"
      },
      {
        "from": "tools/DLSS5Injector/DLSS5Injector.exe",
        "to": "DLSS5Injector.exe"
      },
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mrcgibb9876-hash",
      "repo": "OptiDLSS5-UI"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
